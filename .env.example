# Copy to .env for local dev. In production every value is a GitHub Actions secret.
# Never commit real values: this repo is public.

# Public address of the app, no trailing slash (used to build the login return URLs)
PUBLIC_URL=https://<DUCKDNS_SUBDOMAIN>.duckdns.org

# Access: long random string; the streamer's link is https://<host>/s/<ACCESS_SECRET>/
ACCESS_SECRET=

# YouTube: Google Cloud > APIs & Services > Credentials. Restrict the key to "YouTube Data API v3".
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Replies: Google Cloud > OAuth consent screen (External, publish "In production", leave unverified),
# then Credentials > OAuth client ID (Web application).
# Redirect: https://<DUCKDNS_SUBDOMAIN>.duckdns.org/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitch: dev.twitch.tv/console > Register Your Application.
# OAuth redirect: https://<DUCKDNS_SUBDOMAIN>.duckdns.org/auth/twitch/callback
# (no secret in it; rotating ACCESS_SECRET never requires touching the Twitch console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# DuckDNS: duckdns.org, after signing in. Subdomain without ".duckdns.org".
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# App state (tokens, pins, quota, HTTPS certificates): a pre-authenticated request (PAR) link to your
# private bucket. Bucket > Pre-authenticated requests > Create: target "Bucket", access "Permit object reads
# and writes", far-future expiry. Copy the URL (shown only once; it ends in /o/). Treat it like a password.
# Leave empty for local runs: the app then keeps state in STATE_FILE only.
STATE_PAR_URL=

# ---- GitHub Actions secrets only (used by the watchdog, not by the app) ----
# Profile > My profile > API keys > Add API key: download the private key; the dialog shows the values below.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_REGION=
# The whole private key file, including the BEGIN/END lines.
OCI_PRIVATE_KEY=
# Where the VM lives; the tenancy OCID (root compartment) is fine.
OCI_COMPARTMENT_OCID=
